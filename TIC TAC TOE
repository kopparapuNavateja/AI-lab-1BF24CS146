import random

def create_board():
    
    return [[" " for _ in range(3)] for _ in range(3)]

def print_board(board):
    print("\n")
    for i in range(3):
        print(f" {board[i][0]} | {board[i][1]} | {board[i][2]} ")
        if i < 2:
            print("---+---+---")
    print("\n")

def get_empty_cells(board):
    empty_cells = []
    for r in range(3):
        for c in range(3):
            if board[r][c] == " ":
                empty_cells.append((r, c))
    return empty_cells

def check_winner(board, player):
    for i in range(3):
        if all(board[i][j] == player for j in range(3)):  # Row win
            return True
        if all(board[j][i] == player for j in range(3)):  # Column win
            return True
            
    if board[0][0] == player and board[1][1] == player and board[2][2] == player:
        return True
    if board[0][2] == player and board[1][1] == player and board[2][0] == player:
        return True
        
    return False

def user_move(board):
    while True:
        try:
            move = int(input("User 1 (X) -> Enter position (1-9): "))
            if move < 1 or move > 9:
                print("Invalid input! Please enter a number between 1 and 9.")
                continue
            
            row = (move - 1) // 3
            col = (move - 1) % 3
            
            if board[row][col] == " ":
                board[row][col] = "X"
                break
            else:
                print("That spot is already taken! Try another one.")
        except ValueError:
            print("Please enter a valid integer.")

def computer_move(board):
    empty_cells = get_empty_cells(board)
    if empty_cells:
        row, col = random.choice(empty_cells)
        board[row][col] = "O"
        grid_num = (row * 3) + col + 1
        print(f"Computer (O) chose position: {grid_num}")

def play_game():
    print("=== WELCOME TO TIC TAC TOE ===")
    print("Grid Reference:")
    print(" 1 | 2 | 3 \n---+---+---\n 4 | 5 | 6 \n---+---+---\n 7 | 8 | 9 ")
    
    board = create_board()
    print_board(board)
    
    while True:
        user_move(board)
        print_board(board)
        if check_winner(board, "X"):
            print(" Congratulations! User 1 (X) wins! ")
            break
        if not get_empty_cells(board):
            print(" It's a draw! ")
            break
            
        computer_move(board)
        print_board(board)
        if check_winner(board, "O"):
            print(" Computer (O) wins! Better luck next time. ")
            break
        if not get_empty_cells(board):
            print(" It's a draw! ")
            break

if __name__ == "__main__":
    play_game()
